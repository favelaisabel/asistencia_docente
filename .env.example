# Variables de entorno del proyecto (copia este archivo como .env si las necesitas).
# Nunca subas el archivo .env ni credenciales al repositorio (08_SEGURIDAD_CONTINUIDAD, C-16).

# --- App Flutter (se pasan con --dart-define, no se leen de .env) ---
# USAR_EMULADOR=true          # true: usa el emulador local (proyecto demo-asistencia-docente)
# HOST_EMULADOR=192.168.1.50  # solo con celular físico: IP local de la PC que corre el emulador
#
# Ejemplo:
#   flutter run -t lib/main_movil.dart --dart-define=HOST_EMULADOR=192.168.1.50

# --- Scripts de administración (migraciones / restauración, a partir de I6) ---
# Ruta a la clave de cuenta de servicio, guardada FUERA del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/fuera/del/repo/clave-cuenta-servicio.json
